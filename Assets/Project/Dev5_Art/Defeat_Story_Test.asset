  m_Script: {fileID: 11500000, guid: 7b3687008d940a54e92e248ce158e51c, type: 3}
  m_Name: Defeat_Story_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: defeat_story
  mode: 0
  lines:
  - speakerName:
    text: "Phòng tuyến đã bị phá vỡ."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 1
    musicClip: {fileID: 8300000, guid: 59992d2c02014614aa5fe0f69411f57a, type: 3}
  - speakerName:
    text: "Quân Hắc Mộc tiến đến trung tâm Linh Thành. Linh Ấn Cổ Loa bị bóng tối bao phủ."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Hắc Mộc: Các ngươi không thể bảo vệ những gì chính mình đã lãng quên."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Ánh sáng trong Linh Thành dần tắt. Nhưng thời gian vẫn chưa hoàn toàn khép lại."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "An Dương Vương: Trận chiến vẫn chưa kết thúc. Ta sẽ điều chỉnh đội hình và giữ vững từng lớp phòng tuyến!"
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Dòng Chảy Lịch Sử vẫn còn một cơ hội. An Dương Vương có thể trở lại trước cuộc tấn công, điều chỉnh đội hình và bảo vệ Linh Ấn Cổ Loa."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "ĐÃ MỞ KHÓA"
