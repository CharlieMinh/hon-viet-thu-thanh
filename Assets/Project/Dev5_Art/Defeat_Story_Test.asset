  m_Name: Defeat_Story_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: defeat_story
  mode: 0
  lines:
  - speakerName: 
    text: "Phòng tuyến đã bị phá vỡ. Quân Hắc Mộc tiến đến trung tâm Linh Thành và bóng tối bắt đầu bao phủ các Linh Ấn."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Hắc Mộc: Các ngươi không thể bảo vệ những gì chính mình đã lãng quên."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Ánh sáng trong Linh Thành dần tắt. Nhưng thời gian vẫn chưa hoàn toàn khép lại."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Người Giữ Thành vẫn còn cơ hội quay lại trước cuộc tấn công, thay đổi đội hình và viết lại kết cục."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "ĐÃ MỞ KHÓA"
