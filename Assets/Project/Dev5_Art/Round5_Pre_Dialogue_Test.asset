MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b3687008d940a54e92e248ce158e51c, type: 3}
  m_Name: Round5_Pre_Dialogue_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: round5_pre_dialogue
  mode: 1
  lines:
  - speakerName: "Người dẫn chuyện"
    text: "Đợt tổng công kích đã bị đẩy lui, nhưng tà khí còn sót lại đang hội tụ vào một Orc chỉ huy."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: "Người dẫn chuyện"
    text: "Cơ thể hắn trở nên khổng lồ. Lớp giáp chuyển thành màu tím đen. Orc Chúa Hắc Mộc đã xuất hiện."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: "Orc Chúa"
    text: "Ta không còn là một chiến binh Orc. Ta là ý chí của Hắc Mộc."
    portrait: {fileID: 0}
    portraitSide: 2
    audioClip: {fileID: 0}
  - speakerName: "Orc Chúa"
    text: "Ta sẽ tự tay bóp nát Linh Ấn Cổ Loa!"
    portrait: {fileID: 0}
    portraitSide: 2
    audioClip: {fileID: 0}
  - speakerName: "Thông báo"
    text: "BOSS XUẤT HIỆN — ORC CHÚA HẮC MỘC"
    portrait: {fileID: 0}
    portraitSide: 2
    audioClip: {fileID: 0}
  - speakerName: "Thông báo"
    text: "Hãy dùng toàn bộ Linh Khí còn lại để hoàn thiện đội hình."
    portrait: {fileID: 0}
    portraitSide: 2
    audioClip: {fileID: 0}
  - speakerName: "An Dương Vương"
    text: "Toàn quân nghe lệnh! Giữ vững phòng tuyến và tập trung sức mạnh tiêu diệt Orc Chúa!"
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  - speakerName: "Liên Châu Xạ Vệ"
    text: "Lớp tà khí ấy dù dày đến đâu cũng không thể chống lại những loạt tên mãi mãi."
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  - speakerName: "Huyền Giáp Hộ Vệ"
    text: "Chúng ta sẽ giữ phòng tuyến cho đến thời khắc cuối cùng."
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  - speakerName: "Thiết Kích Chiến Vệ"
    text: "Hãy để ta đối đầu trực diện với hắn!"
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "ĐÃ MỞ KHÓA"
  unlockHeroName: 
  unlockRole: 
  unlockDescription: 
