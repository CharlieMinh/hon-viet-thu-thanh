  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b3687008d940a54e92e248ce158e51c, type: 3}
  m_Name: Intro_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: intro_opening
  mode: 0
  lines:
  - speakerName: 
    text: "Từ thuở dựng nước, những chiến công và ký ức của non sông chưa bao giờ thực sự biến mất."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Chúng hội tụ thành Dòng Chảy Lịch Sử, nơi quá khứ nối liền với hiện tại."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Tại nơi những dòng lịch sử giao nhau, Linh Thành đứng vững, lưu giữ Linh Ấn của các anh hùng bảo vệ non sông."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Nhưng từ những câu chuyện bị lãng quên, một thực thể tà ác đã sinh ra. Tên của nó là Hắc Mộc."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Hắc Mộc: Những gì bị lãng quên rồi sẽ thuộc về ta."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Hắc Mộc mở khe nứt trước cổng Linh Thành, biến ký ức méo mó thành Goblin, Orc và Pháp sư bóng tối."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Trước nguy cơ ấy, một Người Giữ Thành mới được đánh thức."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Hãy dùng Linh Khí để triệu hồi Linh Ảnh anh hùng, sắp xếp họ trên bàn cờ phòng thủ, và bảo vệ Linh Thành."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "HỒN VIỆT THỦ THÀNH"
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: 
    text: "Hồn Việt còn - Lịch sử còn"
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "ĐÃ MỞ KHÓA"
  unlockHeroName: 
  unlockRole: 
  unlockDescription: 
