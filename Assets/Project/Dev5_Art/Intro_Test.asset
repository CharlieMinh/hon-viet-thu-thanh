%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b3687008d940a54e92e248ce158e51c, type: 3}
  m_Name: Intro_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: intro_opening
  mode: 0
  lines:
  - speakerName:
    text: "Từ thuở dựng nước, những chiến công và ký ức của non sông chưa bao giờ thực sự biến mất."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 1
    musicClip: {fileID: 8300000, guid: 4bf0e687a246f3941b81cac785d4331c, type: 3}
  - speakerName:
    text: "Chúng hội tụ thành Dòng Chảy Lịch Sử, nơi quá khứ nối liền với hiện tại."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Tại nơi những dòng lịch sử giao nhau, Linh Thành đứng vững, lưu giữ Linh Ấn Cổ Loa và ký ức về những người đã bảo vệ non sông."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Nhưng từ những câu chuyện bị lãng quên, một thực thể tà ác đã sinh ra. Tên của nó là Hắc Mộc."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Hắc Mộc: Những gì bị lãng quên rồi sẽ thuộc về ta."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 1
    musicClip: {fileID: 8300000, guid: 1a70baee597564f4898e57a0b34a0792, type: 3}
  - speakerName:
    text: "Hắc Mộc mở khe nứt trước cổng Linh Thành, biến những ký ức chiến tranh bị bóp méo thành Goblin, Orc và Pháp Sư bóng tối."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Trước nguy cơ ấy, Vương Linh An Dương Vương được đánh thức tại đài chỉ huy."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Người không trực tiếp xuất trận, mà triệu tập những Chiến Vệ trung thành của Âu Lạc để bảo vệ Linh Thành."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Hãy dùng Linh Khí để triệu hồi các Chiến Vệ, sắp xếp họ trên bàn cờ phòng thủ và thực hiện mệnh lệnh của An Dương Vương."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "An Dương Vương: Toàn quân nghe lệnh! Giữ vững phòng tuyến, không được để tà quân chạm tới Linh Ấn Cổ Loa!"
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "HỒN VIỆT THỦ THÀNH"
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Hồn Việt còn — Lịch sử còn"
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "ĐÃ MỞ KHÓA"
  unlockHeroName: 
  unlockRole: 
  unlockDescription: 
