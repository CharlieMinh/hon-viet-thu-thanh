%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b3687008d940a54e92e248ce158e51c, type: 3}
  m_Name: Victory_Story_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: victory_story
  mode: 0
  lines:
  - speakerName:
    text: "Những loạt tên của Liên Châu Xạ Vệ xuyên qua lớp tà khí bảo vệ Orc Chúa."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 1
    musicClip: {fileID: 8300000, guid: d19cb1b8231fc5b43bcb6a76ab79a31f, type: 3}
  - speakerName:
    text: "Thiết Kích Chiến Vệ phá vỡ lớp giáp tím đen trên cơ thể hắn."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Huyền Giáp Hộ Vệ khóa chặt con đường dẫn đến trung tâm Linh Thành."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Orc Chúa Hắc Mộc gục xuống. Khe nứt trước cổng Linh Thành dần khép lại."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Những ký ức từng bị Hắc Mộc bóp méo được giải thoát và trở về với Dòng Chảy Lịch Sử."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "An Dương Vương: Thành trì vẫn còn đứng vững. Một phòng tuyến chỉ có thể tồn tại khi các chiến sĩ biết bảo vệ lẫn nhau."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Liên Châu Xạ Vệ: Cung nỏ của Âu Lạc sẽ tiếp tục bảo vệ Linh Thành."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Huyền Giáp Hộ Vệ: Chừng nào mệnh lệnh giữ thành còn vang lên, chúng ta sẽ không lùi bước."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Thiết Kích Chiến Vệ: Khi Linh Thành cần, chúng ta sẽ một lần nữa trở lại chiến trường."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Cuộc chiến chống lại sự lãng quên vẫn chưa kết thúc."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName:
    text: "Nhưng ký ức về Cổ Loa và những người từng bảo vệ non sông vẫn tiếp tục được lưu truyền."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
    changeMusic: 0
    musicClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "ĐÃ MỞ KHÓA"
  unlockHeroName: 
  unlockRole: 
  unlockDescription: 
