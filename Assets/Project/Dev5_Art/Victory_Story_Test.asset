%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b3687008d940a54e92e248ce158e51c, type: 3}
  m_Name: Victory_Story_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: victory_story
  mode: 0
  lines:
  - speakerName: 
    text: "Nh\u1EEFng lo\u1EA1t t\xEAn c\u1EE7a Li\xEAn Ch\xE2u X\u1EA1 V\u1EC7 xuy\xEAn
      qua l\u1EDBp t\xE0 kh\xED b\u1EA3o v\u1EC7 Orc Ch\xFAa."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: 5eb4f93942732be4da2b57f0da97961c, type: 3}
    changeMusic: 1
    musicClip: {fileID: 8300000, guid: d19cb1b8231fc5b43bcb6a76ab79a31f, type: 3}
  - speakerName: 
    text: "Thi\u1EBFt K\xEDch Chi\u1EBFn V\u1EC7 ph\xE1 v\u1EE1 l\u1EDBp gi\xE1p
      t\xEDm \u0111en tr\xEAn c\u01A1 th\u1EC3 h\u1EAFn."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: e372e6d3834b1f149ab6fef312346a16, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "Huy\u1EC1n Gi\xE1p H\u1ED9 V\u1EC7 kh\xF3a ch\u1EB7t con \u0111\u01B0\u1EDDng
      d\u1EABn \u0111\u1EBFn trung t\xE2m Linh Th\xE0nh."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: c25d707d301064c4e957490155383395, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "Orc Ch\xFAa H\u1EAFc M\u1ED9c g\u1EE5c xu\u1ED1ng. Khe n\u1EE9t tr\u01B0\u1EDBc
      c\u1ED5ng Linh Th\xE0nh d\u1EA7n kh\xE9p l\u1EA1i."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: 73f9914a7f0c35c4f9eefe3624412f40, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "Nh\u1EEFng k\xFD \u1EE9c t\u1EEBng b\u1ECB H\u1EAFc M\u1ED9c b\xF3p m\xE9o
      \u0111\u01B0\u1EE3c gi\u1EA3i tho\xE1t v\xE0 tr\u1EDF v\u1EC1 v\u1EDBi D\xF2ng
      Ch\u1EA3y L\u1ECBch S\u1EED."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: a7f26b334d43e564884cd3ab8494ae17, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "An D\u01B0\u01A1ng V\u01B0\u01A1ng: Th\xE0nh tr\xEC v\u1EABn c\xF2n \u0111\u1EE9ng
      v\u1EEFng. M\u1ED9t ph\xF2ng tuy\u1EBFn ch\u1EC9 c\xF3 th\u1EC3 t\u1ED3n t\u1EA1i
      khi c\xE1c chi\u1EBFn s\u0129 bi\u1EBFt b\u1EA3o v\u1EC7 l\u1EABn nhau."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: 7617f7b8c85e1074cb03924e60d4aad0, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "Li\xEAn Ch\xE2u X\u1EA1 V\u1EC7: Cung n\u1ECF c\u1EE7a \xC2u L\u1EA1c
      s\u1EBD ti\u1EBFp t\u1EE5c b\u1EA3o v\u1EC7 Linh Th\xE0nh."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: 881d7d66c769c8145b33b13b2595f9bf, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "Huy\u1EC1n Gi\xE1p H\u1ED9 V\u1EC7: Ch\u1EEBng n\xE0o m\u1EC7nh l\u1EC7nh
      gi\u1EEF th\xE0nh c\xF2n vang l\xEAn, ch\xFAng ta s\u1EBD kh\xF4ng l\xF9i b\u01B0\u1EDBc."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: 8aa5f20bf37c92747a6b60de510fcb0a, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "Thi\u1EBFt K\xEDch Chi\u1EBFn V\u1EC7: Khi Linh Th\xE0nh c\u1EA7n, ch\xFAng
      ta s\u1EBD m\u1ED9t l\u1EA7n n\u1EEFa tr\u1EDF l\u1EA1i chi\u1EBFn tr\u01B0\u1EDDng."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: d5ca857ef99b94746bcc710d5527587e, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "Cu\u1ED9c chi\u1EBFn ch\u1ED1ng l\u1EA1i s\u1EF1 l\xE3ng qu\xEAn v\u1EABn
      ch\u01B0a k\u1EBFt th\xFAc."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: 6df5e9c1e4631034e95fff253e283e3f, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  - speakerName: 
    text: "Nh\u01B0ng k\xFD \u1EE9c v\u1EC1 C\u1ED5 Loa v\xE0 nh\u1EEFng ng\u01B0\u1EDDi
      t\u1EEBng b\u1EA3o v\u1EC7 non s\xF4ng v\u1EABn ti\u1EBFp t\u1EE5c \u0111\u01B0\u1EE3c
      l\u01B0u truy\u1EC1n."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 8300000, guid: 4ce49b4519ce973408e3aca13798aed0, type: 3}
    changeMusic: 0
    musicClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "\u0110\xC3 M\u1EDE KH\xD3A"
  unlockHeroName: 
  unlockRole: 
  unlockDescription: 
