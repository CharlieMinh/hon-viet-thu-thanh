  m_Script: {fileID: 11500000, guid: 7b3687008d940a54e92e248ce158e51c, type: 3}
  m_Name: Round3_Pre_Dialogue_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: round3_pre_dialogue
  mode: 1
  lines:
  - speakerName: "Người Giữ Thành"
    text: "Phòng tuyến vẫn đứng vững, nhưng tà thuật lạnh lẽo bắt đầu len qua khe nứt."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: "Pháp sư Hắc Mộc"
    text: "Kết giới chỉ ngăn được đao kiếm. Nó không thể bảo vệ các ngươi khỏi tà thuật."
    portrait: {fileID: 0}
    portraitSide: 2
    audioClip: {fileID: 0}
  - speakerName: "Người Giữ Thành"
    text: "Các Pháp sư Hắc Mộc xuất hiện phía sau đội quân Orc, phóng tà thuật vào các Linh Ảnh."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: "Người Giữ Thành"
    text: "Mặt đất Linh Thành rung chuyển. Sức mạnh Tản Viên trỗi dậy. Sơn Tinh đã thức tỉnh."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: "Sơn Tinh"
    text: "Núi sông còn vững, tà vật không thể vượt qua. Kẻ nào xâm phạm Linh Thành sẽ bị sức mạnh Tản Viên nghiền nát!"
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  - speakerName: "Thông báo"
    text: "Đội hình hoàn chỉnh đã được mở khóa."
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "ĐÃ MỞ KHÓA"
  unlockHeroName: 
  unlockRole: 
  unlockDescription: 
