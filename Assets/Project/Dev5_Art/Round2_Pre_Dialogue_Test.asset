  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b3687008d940a54e92e248ce158e51c, type: 3}
  m_Name: Round2_Pre_Dialogue_Test
  m_EditorClassIdentifier: Assembly-CSharp::HonVietThuThanh.Dev5.StorySequence
  sequenceId: round2_pre_dialogue
  mode: 1
  lines:
  - speakerName: "Người dẫn chuyện"
    text: "Đội quân dò đường của Hắc Mộc đã bị đánh bại, nhưng những tiếng bước chân nặng nề đang đến gần."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: "Hắc Mộc"
    text: "Các ngươi đã đánh bại những kẻ yếu nhất. Hãy xem phòng tuyến ấy đứng vững được bao lâu."
    portrait: {fileID: 0}
    portraitSide: 2
    audioClip: {fileID: 0}
  - speakerName: "Người dẫn chuyện"
    text: "Orc Hắc Mộc tiến vào trận. Chúng chậm hơn Goblin, nhưng có sức mạnh và sinh mệnh vượt trội."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: "Người dẫn chuyện"
    text: "Trước sức ép ấy, những tấm huyền giáp đồng loạt dựng lên trước phòng tuyến. Huyền Giáp Hộ Vệ đã được triệu tập."
    portrait: {fileID: 0}
    portraitSide: 0
    audioClip: {fileID: 0}
  - speakerName: "Huyền Giáp Hộ Vệ"
    text: "Huyền giáp dựng trận, bảo hộ Linh Thành! Chừng nào phòng tuyến còn tồn tại, tà quân không thể chạm tới Linh Ấn!"
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  - speakerName: "An Dương Vương"
    text: "Hãy để Huyền Giáp Hộ Vệ giữ tuyến trước. Không được để quân địch tiếp cận Liên Châu Xạ Vệ!"
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  - speakerName: "Thông báo"
    text: "Đặt Huyền Giáp Hộ Vệ ở tuyến trước để bảo vệ Liên Châu Xạ Vệ."
    portrait: {fileID: 0}
    portraitSide: 1
    audioClip: {fileID: 0}
  unlockPortrait: {fileID: 0}
  unlockTitle: "ĐÃ MỞ KHÓA"
  unlockHeroName: 
  unlockRole: 
  unlockDescription: 
